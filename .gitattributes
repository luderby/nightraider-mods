# Treat every file as binary by default: what is committed is exactly what is on disk.
# Without this, a machine with core.autocrlf=true reports every text file as modified even
# though the committed bytes already match.
* -text

# Source, docs and scripts are UTF-8 with LF.
*.cs         text eol=lf
*.csproj     text eol=lf
*.props      text eol=lf
*.md         text eol=lf
*.ps1        text eol=lf
*.json       text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# The tier tables are UTF-8 with BOM and are edited in Excel. They are stored literally,
# with no line-ending conversion, so the file on disk, the blob in the index and the blob on
# the server are always the same bytes. The BOM is what makes Excel read the Chinese column
# names correctly, and Excel copes with either line ending.
*.csv        -text
